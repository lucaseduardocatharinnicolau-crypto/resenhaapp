{
  "name": "resenha",
  "productName": "Resenha",
  "version": "1.3.0",
  "description": "Call de voz, compartilhamento de tela e chat entre amigos, sem servidor central.",
  "main": "main.js",
  "author": "Lucas",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js --port 7777",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dir --arm64 --x64"
  },
  "dependencies": {
    "mqtt": "^5.16.0",
    "node-turn": "^0.0.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.lucas.resenha",
    "productName": "Resenha",
    "files": [
      "main.js",
      "preload.js",
      "net-tools.js",
      "tunnel-main.js",
      "updater.js",
      "server/**",
      "app/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "app/icon.png"
    },
    "portable": {
      "artifactName": "Resenha.exe"
    },
    "mac": {
      "target": "dir",
      "icon": "app/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Resenha usa o microfone para a call de voz.",
        "NSCameraUsageDescription": "O Resenha usa a câmera se você ligar o vídeo.",
        "NSAudioCaptureUsageDescription": "O Resenha captura o som do Mac quando você compartilha a tela com áudio.",
        "NSScreenCaptureUsageDescription": "O Resenha precisa gravar a tela para compartilhar com os amigos."
      }
    }
  }
}
